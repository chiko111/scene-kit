{
  "name": "@chiko111/scene-kit-core",
  "version": "0.2.0",
  "description": "Scene schema, validation and helpers for scene-kit (animated, data-driven banners for React and React Native).",
  "license": "MIT",
  "author": "chiko111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiko111/scene-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/chiko111/scene-kit#readme",
  "bugs": "https://github.com/chiko111/scene-kit/issues",
  "keywords": [
    "react",
    "react-native",
    "animation",
    "banner",
    "server-driven-ui",
    "editor",
    "json"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "scene.schema.json",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "scene-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scene.schema.json": "./scene.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-schema.mjs && node scripts/generate-fixtures.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
