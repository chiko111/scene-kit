  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native": "./dist/index.js",
  "dependencies": {
    "@chiko111/scene-kit-core": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-native": ">=0.81.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": "*",
    "expo-image": ">=2.0.0"
