{
  "name": "@chiko111/scene-kit-native",
  "version": "0.2.0",
  "description": "React Native renderer for scene-kit scenes \u2014 Reanimated + expo-image.",
  "license": "MIT",
  "author": "chiko111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiko111/scene-kit.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/chiko111/scene-kit#readme",
  "bugs": "https://github.com/chiko111/scene-kit/issues",
  "keywords": [
    "react",
    "react-native",
    "animation",
    "banner",
    "server-driven-ui",
    "editor",
    "json"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "scene-kit-source": "./src/index.ts",
